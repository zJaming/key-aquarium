{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Key Aquarium",
  "version": "0.1.2",
  "identifier": "io.github.zjaming.keyaquarium",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Key Aquarium",
        "width": 980,
        "height": 520,
        "minWidth": 100,
        "minHeight": 100,
        "transparent": true,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwQUI3MEJDMzM2MDMwNkEKUldScU1HQXp2SENyMERSdVpubTRtTzNOQS90K0hXQnBiajRsZk1qSlZzdWlqd3ZsKzJoSkhOWGYK",
      "endpoints": [
        "https://github.com/zJaming/key-aquarium/releases/latest/download/latest.json"
      ]
    }
  }
}
